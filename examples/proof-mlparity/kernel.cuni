# ML inference parity kernel — integer-only.
#
# A scoring step shaped like the heart of an inference pass: C = A @ B
# (4x4 integer matrix multiply, the stand-in for a logits layer), then
# argmax over row 0 of C (the stand-in for top-1 class selection).
#
# INTEGER ARITHMETIC ONLY. Cross-language float exactness (op ordering,
# fused multiply-add, libm differences) cannot be guaranteed, so the float
# kernel is refused rather than faked — see README.md.

def idx(r: int, c: int) -> int do
    ret r * 4 + c
end

# Fixed weights (A) and inputs (B); small values, no overflow anywhere.
let a = [3, 1, 2, 0, 0, 2, 1, 4, 1, 0, 3, 2, 2, 1, 0, 3]
let b = [1, 0, 2, 1, 2, 3, 0, 1, 1, 1, 2, 0, 0, 2, 1, 3]

mut c: list<int> = []
for r in range(4) do
    for col in range(4) do
        mut acc = 0
        for k in range(4) do
            acc = acc + a[idx(r, k)] * b[idx(k, col)]
        end
        c.push(acc)
    end
end

# Argmax over row 0 of C — top-1 selection.
mut best = 0
mut bi = 1
whl bi < 4 do
    if c[bi] > c[best] do
        best = bi
    end
    bi = bi + 1
end

say(`${c[0]} ${c[1]} ${c[2]} ${c[3]}`)
say(`${c[4]} ${c[5]} ${c[6]} ${c[7]}`)
say(`${c[8]} ${c[9]} ${c[10]} ${c[11]}`)
say(`${c[12]} ${c[13]} ${c[14]} ${c[15]}`)
say(`argmax=${best}`)
