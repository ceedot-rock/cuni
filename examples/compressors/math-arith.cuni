# MTH1 ARITH_U8. Encode stores a, step, n. Decode generates byte i.
# Packed size is 11 (4 magic + 1 kind + 1 a + 1 step + 4 n). Never expand.

def u8(x: int) -> int do
    let m = x % 256
    if m < 0 do
        ret m + 256
    end
    ret m
end

def encode_byte(a: int, step: int, i: int) -> int do
    ret u8(a + step * i)
end

def decode_byte(a: int, step: int, i: int) -> int do
    ret u8(a + step * i)
end

def decode_sum(a: int, step: int, n: int) -> int do
    mut s = 0
    mut i = 0
    whl i < n do
        s = s + decode_byte(a, step, i)
        i = i + 1
    end
    ret s
end

def packed_arith_u8(n: int) -> int do
    ret 11
end

def keep_arith(n: int) -> int do
    let coded = packed_arith_u8(n)
    if coded >= n do
        ret n
    end
    ret coded
end

def roundtrip(a: int, step: int, n: int) -> int do
    mut i = 0
    whl i < n do
        if decode_byte(a, step, i) != encode_byte(a, step, i) do
            ret 0
        end
        i = i + 1
    end
    ret 1
end

# a=3 step=2 n=20 → 3,5,…,41. Sum = 440.
say(decode_sum(3, 2, 20))
say(packed_arith_u8(20))
say(keep_arith(20))
say(keep_arith(10))
say(decode_byte(3, 2, 0))
say(decode_byte(3, 2, 19))
say(roundtrip(3, 2, 20))
