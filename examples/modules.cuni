# Portable import + deliberate ext/global collision demo.
# `use math` loads examples/math.cuni (see src/modules.rs).
# The `ext fetch` name collides with the JS global `fetch` — `--emit-js`
# must refuse (src/checks.rs), not emit self-recursive JS.

use math

ext fetch(url: str) -> str do
    py: requests.get(url).text
    go: httpGet(url)
    js: await fetch(url).then(r => r.text())
end

let sum = add(2, 3)
say(sum)
let page = fetch("https://example.com")
say(page)
