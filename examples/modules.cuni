# Portable import + ext demo (clean working example).
# `use math` loads examples/math.cuni (see src/modules.rs).
# The `ext geet` name does NOT collide with any target global —
# every seat emits cleanly. For the deliberate collision case,
# see examples/ext-collision.cuni (which the compiler yeets).

use math

ext geet(url: str) -> str do
    py: requests.get(url).text
    go: httpGet(url)
    js: await fetch(url).then(r => r.text())
end

let sum = add(2, 3)
say(sum)
let page = geet("https://example.com")
say(page)
