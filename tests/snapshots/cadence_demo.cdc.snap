/// Generated by the CuNi Cadence backend ("Trust Provable, in all things.").
///
/// STRUCTURE — two delimited regions, one law (same logic or refuse):
/// - Logic region (CUNI-LOGIC-CORE-START/END), nested inside the contract:
///   the pure program logic as `access(self)` helpers. `dec` is an
///   `Int256` scaled by 10^4 — deliberately NOT Cadence's native
///   `Fix64` (scale 10^8): CuNi proves the semantics it was given.
///   `say` is `log(...)`. A `dec` logs as its exact scaled integer
///   (12499 for 1.2499); the canonical `1.2499` rendering
///   (docs/DECIMAL.md §6) is proven in the Python reference the gate
///   runs (`--emit-cadence-ref`).
/// - Shell region (CUNI-CADENCE-SHELL-START/END): the `access(all)`
///   contract, one public function per CuNi function delegating to its
///   helper, plus the `cuniDriver` entry replaying the top-level `say`s.
///   Requires the Flow/Cadence toolchain; NOT compiled by `cuni check`.
///
/// HONEST BOUNDARIES: the logic core is gate-proven via the Python
/// reference; the contract shell is NOT compiled here and nothing has
/// executed on-chain. Re-verify Int256 `/`-and-`%`-truncate-toward-zero
/// on the Cadence toolchain before deployment.
/// Full verification matrix: docs/ONCHAIN.md.

// CUNI-CADENCE-SHELL-START
access(all) contract CuniDemo {

    // CUNI-LOGIC-CORE-START
    // Pure logic: `access(self)` helpers. CuNi `int` is `Int256`;
    // CuNi `dec` is an `Int256` scaled by 10^4 (see module header).

    access(self) fun truncDivImpl(a: Int256, b: Int256): Int256 {
        return (a / b);
    }

    access(self) fun truncModImpl(a: Int256, b: Int256): Int256 {
        return (a % b);
    }

    access(self) fun feeImpl(amount: Int256): Int256 {
        if (amount <= 1000000 /* 100.0dec */) {
            return (((amount * 100 /* 0.01dec */) / 10000) + 2500 /* 0.25dec */);
        }
        return (((amount * 50 /* 0.005dec */) / 10000) + 2500 /* 0.25dec */);
    }

    access(self) fun tierNameImpl(amount: Int256): String {
        if (amount <= 1000000 /* 100.0dec */) {
            return "tier-".concat("one");
        }
        return "tier-two";
    }

    access(self) fun approvedImpl(ok: Bool, amount: Int256): Bool {
        if ok {
            return (amount > 0);
        }
        return false;
    }

    // CUNI-LOGIC-CORE-END

    // Public surface: each function delegates to its logic helper.

    access(all) fun truncDiv(a: Int256, b: Int256): Int256 {
        return self.truncDivImpl(a: a, b: b);
    }

    access(all) fun truncMod(a: Int256, b: Int256): Int256 {
        return self.truncModImpl(a: a, b: b);
    }

    access(all) fun fee(amount: Int256): Int256 {
        return self.feeImpl(amount: amount);
    }

    access(all) fun tierName(amount: Int256): String {
        return self.tierNameImpl(amount: amount);
    }

    access(all) fun approved(ok: Bool, amount: Int256): Bool {
        return self.approvedImpl(ok: ok, amount: amount);
    }

    // Driver: replays the top-level `say` statements via `log`.
    access(all) fun cuniDriver(): Bool {
        log(self.truncDivImpl(a: (-7), b: 3));
        log(self.truncDivImpl(a: 7, b: (-3)));
        log(self.truncModImpl(a: (-7), b: 3));
        log(self.feeImpl(amount: 999999 /* 99.9999dec */));
        log(self.feeImpl(amount: 2500000 /* 250.0dec */));
        log(self.tierNameImpl(amount: 100000 /* 10.0dec */));
        log(self.tierNameImpl(amount: 5000000 /* 500.0dec */));
        log(self.approvedImpl(ok: true, amount: 5));
        log(self.approvedImpl(ok: false, amount: 5));
        log((self.feeImpl(amount: 999999 /* 99.9999dec */) / 10000));
        log(((3 * 10000) + 5000 /* 0.5dec */));
        return true;
    }

}
// CUNI-CADENCE-SHELL-END
