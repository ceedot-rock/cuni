// TODO: replace 0xCUNI with your real publish address before publishing.
module 0xCUNI::cuni_demo {
    use std::debug;
    use std::string::{Self, String};
    use std::string_utils;
    use std::vector;

// CUNI-LOGIC-CORE-START
    /// One decimal digit (0-9) as its ASCII byte, for `cuni_dec_str`.
    fun cuni_digit(d: u128): u8 {
        (48 + (d as u8))
    }

    /// Canonical `dec` rendering (docs/DECIMAL.md §6): scaled u128 ->
    /// "D.F" with trailing fractional zeros stripped (never empty).
    fun cuni_dec_str(v: u128): String {
        let scale: u128 = 10000;
        let ip = v / scale;
        let r = v % scale;
        let frac = std::vector::empty<u8>();
        std::vector::push_back(&mut frac, cuni_digit(r / 1000));
        std::vector::push_back(&mut frac, cuni_digit((r / 100) % 10));
        std::vector::push_back(&mut frac, cuni_digit((r / 10) % 10));
        std::vector::push_back(&mut frac, cuni_digit(r % 10));
        while (std::vector::length(&frac) > 1) {
            let last = std::vector::length(&frac) - 1;
            if (*std::vector::borrow(&frac, last) != 48) {
                break;
            };
            std::vector::pop_back(&mut frac);
        };
        let s = std::string_utils::to_string(&ip);
        std::string::append(&mut s, std::string::utf8(b"."));
        std::string::append(&mut s, std::string::utf8(frac));
        s
    }

    /// `dec_of_int`: exact `n * 10000`; `*` aborts loudly on overflow.
    fun cuni_dec_of_int(n: u64): u128 {
        (n as u128) * 10000u128
    }

    /// `int_of_dec`: `trunc(d/10000)` toward zero; loud abort past u64.
    fun cuni_int_of_dec(d: u128): u64 {
        let q = d / 10000u128;
        assert!(q <= 18446744073709551615u128, 2); // cuni: int_of_dec overflow — refused
        (q as u64)
    }

    fun transfer_fee(amount: u64, fee_bps: u64): u64 {
        return ((amount * fee_bps) / 10000u64);
    }

    fun validate_transfer(balance: u64, amount: u64, fee_bps: u64): u64 {
        if ((amount <= 0u64)) {
            return 2u64;
        };
        if ((fee_bps > 10000u64)) {
            return 3u64;
        };
        let total: u64 = (amount + transfer_fee(amount, fee_bps));
        if ((total > balance)) {
            return 1u64;
        };
        return 0u64;
    }

    fun fee(amount: u128): u128 {
        if ((amount <= 1000000u128)) {
            return (((amount * 100u128) / 10000u128) + 2500u128);
        };
        if ((amount <= 10000000u128)) {
            return (((amount * 50u128) / 10000u128) + 2500u128);
        };
        return (((amount * 25u128) / 10000u128) + 2500u128);
    }

    fun label(code: u64): String {
        if ((code == 0u64)) {
            return std::string::utf8(b"ok");
        };
        return std::string::utf8(b"bad");
    }

    fun sum_to(n: u64): u64 {
        let mut total: u64 = 0u64;
        // `for` over `range` lowers to `while` (Move has no int ranges).
        let mut i = 0u64;
        while (i < n) {
            total = (total + i);
            i = i + 1;
        };
        return total;
    }

    fun countdown(n: u64): u64 {
        let mut c: u64 = n;
        while ((c > 0u64)) {
            c = (c - 1u64);
        };
        return c;
    }

    /// Driver: runs the top-level statements in order (the off-chain
    /// `say` sequence). Invoke it as an entry function to replay.
    public entry fun run() {
        std::debug::print(&std::string_utils::to_string(&transfer_fee(10000u64, 50u64)));
        std::debug::print(&std::string_utils::to_string(&validate_transfer(10000u64, 5000u64, 50u64)));
        std::debug::print(&std::string_utils::to_string(&validate_transfer(100u64, 5000u64, 50u64)));
        std::debug::print(&std::string_utils::to_string(&validate_transfer(10000u64, 0u64, 50u64)));
        std::debug::print(&cuni_dec_str(fee(999999u128)));
        std::debug::print(&cuni_dec_str(fee(10000000000u128)));
        std::debug::print(&label(0u64));
        std::debug::print(&label(2u64));
        std::debug::print(&std::string_utils::to_string(&(7u64 / 2u64)));
        std::debug::print(&std::string_utils::to_string(&(7u64 % 2u64)));
        std::debug::print(&(if ((1u64 < 2u64)) { std::string::utf8(b"True") } else { std::string::utf8(b"False") }));
        std::debug::print(&std::string_utils::to_string(&sum_to(10u64)));
        std::debug::print(&std::string_utils::to_string(&countdown(3u64)));
        std::debug::print(&cuni_dec_str(cuni_dec_of_int(5u64)));
        std::debug::print(&std::string_utils::to_string(&cuni_int_of_dec(59999u128)));
    }
// CUNI-LOGIC-CORE-END

