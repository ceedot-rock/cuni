;; Generated by the CuNi Clarity backend ("Trust Provable, in all things.").
;;
;; STRUCTURE — two delimited regions, one law (same logic or refuse):
;; - Logic region (CUNI-LOGIC-CORE-START/END): the pure program logic as
;;   `define-private` helpers. `dec` is a Clarity `int` scaled by 10^4;
;;   `say` is `(print ...)` — the on-chain print event. A `dec` prints
;;   as its exact scaled integer (12499 for 1.2499); the canonical
;;   `1.2499` rendering (docs/DECIMAL.md §6) is proven in the Python
;;   reference the gate runs (`--emit-clarity-ref`).
;; - Shell region (CUNI-CLARITY-SHELL-START/END): the `define-public`
;;   surface — one `(ok (name-impl ...))` wrapper per CuNi function,
;;   plus the `cuni-driver` entry replaying the top-level `say`s.
;;   Requires the Clarity toolchain; NOT compiled by `cuni check`.
;;
;; HONEST BOUNDARIES: the logic core is gate-proven via the Python
;; reference; the contract shell is NOT compiled here and nothing has
;; executed on-chain. Re-verify `/`-and-`mod`-truncate-toward-zero on
;; the Clarity toolchain before deployment.
;; Full verification matrix: docs/ONCHAIN.md.

;; CUNI-LOGIC-CORE-START
(define-private (trunc-div-impl (a int) (b int))
    (ok (/ a b))
)

(define-private (trunc-mod-impl (a int) (b int))
    (ok (mod a b))
)

(define-private (fee-impl (amount int))
    (if (<= amount 1000000)
        (ok (+ (/ (* amount 100) 10000) 2500))
        (ok (+ (/ (* amount 50) 10000) 2500)))
)

(define-private (tier-name-impl (amount int))
    (if (<= amount 1000000)
        (ok (concat u"tier-" u"one"))
        (ok u"tier-two"))
)

(define-private (approved-impl (cuni-ok bool) (amount int))
    (if cuni-ok
        (ok (> amount 0))
        (ok false))
)

;; CUNI-LOGIC-CORE-END

;; CUNI-CLARITY-SHELL-START
;; Contract: cuni-demo
;; Deploy: save this file as `contracts/<name>.clar` in a Clarinet
;; project and run `clarinet check` before any deployment.

(define-public (trunc-div (a int) (b int))
    (ok (trunc-div-impl a b))
)

(define-public (trunc-mod (a int) (b int))
    (ok (trunc-mod-impl a b))
)

(define-public (fee (amount int))
    (ok (fee-impl amount))
)

(define-public (tier-name (amount int))
    (ok (tier-name-impl amount))
)

(define-public (approved (cuni-ok bool) (amount int))
    (ok (approved-impl cuni-ok amount))
)

(define-public (cuni-driver)
    (begin
        (print (trunc-div-impl (- 0 7) 3))
        (print (trunc-div-impl 7 (- 0 3)))
        (print (trunc-mod-impl (- 0 7) 3))
        (print (fee-impl 999999))
        (print (fee-impl 2500000))
        (print (tier-name-impl 100000))
        (print (tier-name-impl 5000000))
        (print (approved-impl true 5))
        (print (approved-impl false 5))
        (print (/ (fee-impl 999999) 10000))
        (print (+ (* 3 10000) 5000))
        (ok true)
    )
)
;; CUNI-CLARITY-SHELL-END
