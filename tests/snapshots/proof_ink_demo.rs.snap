//! Generated by the CuNi ink! backend.
//! "Trust Provable, in all things."
//!
//! STRUCTURE — two delimited regions, one law (same logic or refuse):
//! - `mod logic` (CUNI-LOGIC-CORE markers): the pure program logic,
//!   byte-identical to the standalone logic-core emit. The CuNi gate
//!   proves its stdout byte-identical across real toolchains; it
//!   compiles as plain Rust with no dependencies.
//! - Contract shell (CUNI-INK-SHELL markers): the `#[ink::contract]`
//!   wrapper — storage struct, constructor, one message per CuNi
//!   function. Requires the ink! toolchain (`cargo-contract`); NOT
//!   compiled by `cuni check` (no ink! toolchain on the check
//!   machine). Full verification recipe: docs/ONCHAIN.md.
//!
//! HONEST BOUNDARIES: logic gate-proven; shell not compiled here;
//! nothing here has executed on-chain.

// CUNI-LOGIC-CORE-START
mod logic {
    use ink::prelude::string::String;
    /// CuNi `dec`: scaled i128, scale 10^4 (docs/DECIMAL.md).
    const CUNI_DEC_SCALE: i128 = 10000;

    /// Loud refusal: dec addition that overflows i128 aborts, never wraps.
    fn cuni_dec_add(a: i128, b: i128) -> i128 {
        a.checked_add(b).expect("cuni: dec addition overflow \u{2014} refused")
    }

    /// Loud refusal: dec subtraction that overflows i128 aborts, never wraps.
    fn cuni_dec_sub(a: i128, b: i128) -> i128 {
        a.checked_sub(b).expect("cuni: dec subtraction overflow \u{2014} refused")
    }

    /// `trunc(a*b/10000)` toward zero (docs/DECIMAL.md §3).
    fn cuni_dec_mul(a: i128, b: i128) -> i128 {
        let p = a.checked_mul(b).expect("cuni: dec multiplication overflow \u{2014} refused");
        p / CUNI_DEC_SCALE
    }

    /// `trunc(a*10000/b)` toward zero; division by zero is a loud panic.
    fn cuni_dec_div(a: i128, b: i128) -> i128 {
        if b == 0 {
            panic!("cuni: dec division by zero");
        }
        let p = a.checked_mul(CUNI_DEC_SCALE).expect("cuni: dec division intermediate overflow \u{2014} refused");
        p / b
    }

    fn cuni_dec_neg(a: i128) -> i128 {
        a.checked_neg().expect("cuni: dec negation overflow \u{2014} refused")
    }

    /// `dec_of_int`: exact `n * 10000`; refuses on overflow.
    fn cuni_dec_of_int(n: i64) -> i128 {
        (n as i128).checked_mul(CUNI_DEC_SCALE).expect("cuni: dec_of_int overflow \u{2014} refused")
    }

    /// `int_of_dec`: `trunc(d/10000)` toward zero; refuses on overflow.
    fn cuni_int_of_dec(d: i128) -> i64 {
        let q = d / CUNI_DEC_SCALE;
        if q < i64::MIN as i128 || q > i64::MAX as i128 {
            panic!("cuni: int_of_dec overflow \u{2014} refused");
        }
        q as i64
    }

    /// Canonical `dec` rendering (docs/DECIMAL.md §6): sign, integer
    /// digits, ".", fractional digits with trailing zeros stripped
    /// (never empty — `1.0000` prints as `1.0`).
    fn cuni_dec_str(v: i128) -> String {
        let neg = v < 0;
        let mag = v.unsigned_abs();
        let ip = mag / (CUNI_DEC_SCALE as u128);
        let mut fp = format!("{:04}", mag % (CUNI_DEC_SCALE as u128));
        while fp.ends_with('0') {
            fp.pop();
        }
        if fp.is_empty() {
            fp.push('0');
        }
        format!("{}{}.{}", if neg { "-" } else { "" }, ip, fp)
    }

    pub fn transfer_fee(amount: i64, fee_bps: i64) -> i64 {
        return ((amount * fee_bps) / 10000i64);
    }

    pub fn validate_transfer(balance: i64, amount: i64, fee_bps: i64) -> i64 {
        if (amount <= 0i64) {
            return 2i64;
        }
        if (fee_bps > 10000i64) {
            return 3i64;
        }
        let total: i64 = (amount + transfer_fee(amount, fee_bps));
        if (total > balance) {
            return 1i64;
        }
        return 0i64;
    }

    pub fn fee(amount: i128) -> i128 {
        if (amount <= 1000000i128) {
            return cuni_dec_add(cuni_dec_mul(amount, 100i128), 2500i128);
        }
        if (amount <= 10000000i128) {
            return cuni_dec_add(cuni_dec_mul(amount, 50i128), 2500i128);
        }
        return cuni_dec_add(cuni_dec_mul(amount, 25i128), 2500i128);
    }

    pub fn label(code: i64) -> String {
        if (code == 0i64) {
            return "ok".to_string();
        }
        return "bad".to_string();
    }

    pub fn sum_to(n: i64) -> i64 {
        let mut total: i64 = 0i64;
        for i in 0..n {
            total = (total + i);
        }
        return total;
    }

    pub fn countdown(n: i64) -> i64 {
        let mut c: i64 = n;
        while (c > 0i64) {
            c = (c - 1i64);
        }
        return c;
    }

    fn main() {
        println!("{}", transfer_fee(10000i64, 50i64));
        println!("{}", validate_transfer(10000i64, 5000i64, 50i64));
        println!("{}", validate_transfer(100i64, 5000i64, 50i64));
        println!("{}", validate_transfer(10000i64, 0i64, 50i64));
        println!("{}", cuni_dec_str(fee(999999i128)));
        println!("{}", cuni_dec_str(fee(10000000000i128)));
        println!("{}", label(0i64));
        println!("{}", label(2i64));
        println!("{}", (7i64 / 2i64));
        println!("{}", (7i64 % 2i64));
        println!("{}", if (1i64 < 2i64) { "True" } else { "False" });
        println!("{}", sum_to(10i64));
        println!("{}", countdown(3i64));
        println!("{}", cuni_dec_str(cuni_dec_of_int(5i64)));
        println!("{}", cuni_int_of_dec(59999i128));
    }
}
// CUNI-LOGIC-CORE-END

// CUNI-INK-SHELL-START
// Requires: ink = "4" and the cargo-contract toolchain.
// This shell is NOT compiled by `cuni check` — see docs/ONCHAIN.md.
// Top-level driver statements (the off-chain `say` sequence) are not
// messages: each CuNi function is exposed as one message below;
// invoking them in driver order is the caller's job.

#[ink::contract]
mod cuni_demo {
    use ink::prelude::string::String;
    use super::logic;

    #[ink(storage)]
    pub struct Contract {
        /// Set once at construction; identifies the deploying account.
        owner: AccountId,
    }

    impl Contract {
        /// Deploys the contract and records the caller as owner.
        #[ink(constructor)]
        pub fn new() -> Self {
            Self { owner: Self::env().caller() }
        }

        /// transfer_fee: pure logic lives in `logic::transfer_fee`; this message
        /// computes it on-chain and returns the result.
        #[ink(message)]
        pub fn transfer_fee(&self, amount: i64, fee_bps: i64) -> i64 {
            logic::transfer_fee(amount, fee_bps)
        }

        /// validate_transfer: pure logic lives in `logic::validate_transfer`; this message
        /// computes it on-chain and returns the result.
        #[ink(message)]
        pub fn validate_transfer(&self, balance: i64, amount: i64, fee_bps: i64) -> i64 {
            logic::validate_transfer(balance, amount, fee_bps)
        }

        /// fee: pure logic lives in `logic::fee`; this message
        /// computes it on-chain and returns the result.
        #[ink(message)]
        pub fn fee(&self, amount: i128) -> i128 {
            logic::fee(amount)
        }

        /// label: pure logic lives in `logic::label`; this message
        /// computes it on-chain and returns the result.
        #[ink(message)]
        pub fn label(&self, code: i64) -> String {
            logic::label(code)
        }

        /// sum_to: pure logic lives in `logic::sum_to`; this message
        /// computes it on-chain and returns the result.
        #[ink(message)]
        pub fn sum_to(&self, n: i64) -> i64 {
            logic::sum_to(n)
        }

        /// countdown: pure logic lives in `logic::countdown`; this message
        /// computes it on-chain and returns the result.
        #[ink(message)]
        pub fn countdown(&self, n: i64) -> i64 {
            logic::countdown(n)
        }
    }
}
// CUNI-INK-SHELL-END
